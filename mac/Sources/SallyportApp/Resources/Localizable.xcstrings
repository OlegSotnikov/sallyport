    "Comma-separated hosts. Leave empty for any target. Restrict hosts to limit an allowed process.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Comma-separated hosts. Leave empty for any target. Restrict hosts to limit an allowed process."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kommagetrennte Hosts. Leer lassen, um alle Ziele zu erlauben. Beschränke die Hosts, um die Ziele eines zugelassenen Prozesses einzugrenzen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Hosts separados por comas. Déjalo vacío para permitir cualquier destino. Limita los hosts para restringir los destinos de un proceso permitido."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Hôtes séparés par des virgules. Laissez vide pour autoriser toute cible. Limitez les hôtes pour restreindre un processus autorisé."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Hosts separados por vírgulas. Deixe em branco para qualquer destino. Restrinja os hosts para limitar um processo permitido."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Список хостов через запятую. Оставьте пустым, чтобы разрешить любую цель. Ограничьте хосты, чтобы сузить доступ процесса."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "以逗号分隔主机。留空表示任意目标。限制主机可缩小允许进程的访问范围。"
          }
        }
      }
