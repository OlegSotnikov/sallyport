    "Banners disappear automatically. Select Alerts for Sallyport in System Settings to keep approvals visible.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Banners disappear automatically. Select Alerts for Sallyport in System Settings to keep approvals visible."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Banner werden automatisch ausgeblendet. Wähle in den Systemeinstellungen für Sallyport den Stil „Hinweise“, damit Freigaben sichtbar bleiben."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las notificaciones temporales desaparecen automáticamente. Selecciona «Permanente» para Sallyport en Ajustes del Sistema para mantener visibles las aprobaciones."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les bannières disparaissent automatiquement. Sélectionnez Alertes pour Sallyport dans Réglages Système afin que les autorisations restent visibles."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Os banners desaparecem automaticamente. Selecione Alertas para Sallyport nos Ajustes do Sistema para manter as aprovações visíveis."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Баннеры исчезают автоматически. Чтобы запросы оставались на экране, в Системных настройках выберите для Sallyport стиль уведомлений «Предупреждения»."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "横幅会自动消失。请在“系统设置”中为 Sallyport 选择“提醒”，以使批准请求保持显示。"
          }
        }
      }
    },
