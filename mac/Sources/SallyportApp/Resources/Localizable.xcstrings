    "Sallyport could not identify that executable. Choose another file or running process.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sallyport could not identify that executable. Choose another file or running process."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sallyport konnte diese ausführbare Datei nicht identifizieren. Wähle eine andere Datei oder einen laufenden Prozess."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
