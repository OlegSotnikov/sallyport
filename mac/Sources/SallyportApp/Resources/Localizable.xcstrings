    "Names, hosts, settings, and history are encrypted. Unlock the vault to view them.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Names, hosts, settings, and history are encrypted. Unlock the vault to view them."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Namen, Hosts, Einstellungen und Verlauf sind verschlüsselt. Entsperre den Tresor, um sie anzuzeigen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los nombres, hosts, ajustes y el historial están cifrados. Desbloquea la bóveda para verlos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les noms, hôtes, réglages et historiques sont chiffrés. Déverrouillez le coffre pour les afficher."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Nomes, hosts, ajustes e histórico são criptografados. Desbloqueie o cofre para visualizá-los."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Имена, хосты, настройки и история зашифрованы. Разблокируйте хранилище, чтобы просмотреть их."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "名称、主机、设置和历史记录均已加密。解锁密钥库后才能查看。"
          }
        }
      }
    },
