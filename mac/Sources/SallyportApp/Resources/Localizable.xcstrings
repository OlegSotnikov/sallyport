    "System Default": {
      "localizations": {
        "en": {
          "stringUnit": { "state": "translated", "value": "System Default" }
        },
        "de": {
          "stringUnit": { "state": "translated", "value": "Systemstandard" }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Por omisión del sistema"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Réglage par défaut du système"
          }
        },
        "pt-BR": {
          "stringUnit": { "state": "translated", "value": "Padrão do sistema" }
        },
        "ru": {
