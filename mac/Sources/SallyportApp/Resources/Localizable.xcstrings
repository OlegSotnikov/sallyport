    "Matches only this binary. An update requires session approval or a new allowlist entry.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Matches only this binary. An update requires session approval or a new allowlist entry."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gilt nur für diese Binärdatei. Nach einem Update ist eine Sitzungsfreigabe oder ein neuer Eintrag in der Zulassungsliste erforderlich."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Solo coincide con este binario. Una actualización requiere aprobación de sesión o una nueva entrada en la lista de permitidos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Correspond uniquement à ce binaire. Une mise à jour nécessite une autorisation de session ou une nouvelle entrée dans la liste d’autorisation."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Corresponde somente a este binário. Uma atualização exige aprovação de sessão ou uma nova entrada na lista de permissões."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
