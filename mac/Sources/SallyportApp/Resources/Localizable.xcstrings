    "The session ends when this process exits, you revoke access, or the vault locks. Future requests won't prompt again unless per-call approval applies.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The session ends when this process exits, you revoke access, or the vault locks. Future requests won't prompt again unless per-call approval applies."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Sitzung endet, wenn dieser Prozess beendet wird, du den Zugriff widerrufst oder der Tresor gesperrt wird. Weitere Anfragen werden nicht erneut bestätigt, sofern keine Freigabe pro Aufruf gilt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La sesión termina cuando este proceso finaliza, revocas el acceso o se bloquea la bóveda. Las solicitudes futuras no volverán a pedir confirmación salvo que se aplique la aprobación por llamada."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La session se termine lorsque ce processus s’arrête, que vous révoquez l’accès ou que le coffre se verrouille. Les requêtes suivantes ne demanderont plus de confirmation, sauf si l’autorisation par appel s’applique."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A sessão termina quando este processo é encerrado, você revoga o acesso ou o cofre é bloqueado. Solicitações futuras não pedirão nova confirmação, a menos que a aprovação por chamada seja aplicada."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сеанс завершится при завершении процесса, отзыве доступа или блокировке хранилища. Следующие запросы не потребуют подтверждения, кроме запросов с настройкой подтверждения каждого вызова."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "当此进程退出、你撤销访问权限或密钥库锁定时，会话结束。后续请求不会再次提示，除非启用了每次调用审批。"
          }
        }
      }
    },
