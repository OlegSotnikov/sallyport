    "Trust on first use records the first key seen. Strict mode requires a known key.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Trust on first use records the first key seen. Strict mode requires a known key."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Beim ersten Zugriff wird der zuerst erkannte Schlüssel gespeichert. Der strikte Modus erfordert einen bekannten Schlüssel."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Al confiar en el primer uso se registra la primera clave detectada. El modo estricto requiere una clave conocida."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La confiance à la première utilisation enregistre la première clé reçue. Le mode Strict nécessite une clé connue."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Confiar no primeiro uso registra a primeira chave recebida. O modo Estrito exige uma chave conhecida."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "При первом подключении сохраняется первый полученный ключ. В строгом режиме ключ должен быть известен заранее."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "首次使用时信任会记录首次发现的密钥。严格模式需要已知密钥。"
          }
        }
      }
    },
