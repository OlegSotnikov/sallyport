    "The process is a shell, typically a command another program ran.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The process is a shell, typically a command another program ran."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Prozess ist eine Shell, üblicherweise ein Befehl, den ein anderes Programm ausgeführt hat."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El proceso es un shell, normalmente un comando ejecutado por otro programa."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le processus est un shell, généralement une commande exécutée par un autre programme."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O processo é um shell, normalmente um comando executado por outro programa."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
