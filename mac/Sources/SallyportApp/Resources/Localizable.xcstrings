    "Security settings are encrypted. Unlock the vault to view or change them.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Security settings are encrypted. Unlock the vault to view or change them."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sicherheitseinstellungen sind verschlüsselt. Entsperre den Tresor, um sie anzuzeigen oder zu ändern."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los ajustes de seguridad están cifrados. Desbloquea la bóveda para verlos o cambiarlos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les réglages de sécurité sont chiffrés. Déverrouillez le coffre pour les afficher ou les modifier."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Os ajustes de segurança são criptografados. Desbloqueie o cofre para visualizá-los ou alterá-los."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Настройки безопасности зашифрованы. Разблокируйте хранилище, чтобы просмотреть или изменить их."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "安全性设置已加密。解锁密钥库后才能查看或更改。"
          }
        }
      }
    },
    "Separate P-256 ECDSA key · signs audit rows, not approval decisions": {
      "localizations": {
