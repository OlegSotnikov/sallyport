    "Matches future builds signed by %@ with bundle %@. Use only if you trust future updates from that signer.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Matches future builds signed by %@ with bundle %@. Use only if you trust future updates from that signer."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gilt für zukünftige Builds, die von %@ mit Bundle %@ signiert sind. Verwende dies nur, wenn du zukünftigen Updates dieses Signierers vertraust."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Coincide con versiones futuras firmadas por %@ con el bundle %@. Úsalo solo si confías en las futuras actualizaciones de ese firmante."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Correspond aux futures versions signées par le développeur %@ avec le bundle %@. Utilisez cette option uniquement si vous faites confiance aux futures mises à jour de ce signataire."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Corresponde a versões futuras assinadas pelo desenvolvedor %@ com o bundle %@. Use somente se confiar nas futuras atualizações desse signatário."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Совпадут будущие сборки, подписанные %@ и входящие в пакет %@. Используйте этот вариант, только если доверяете будущим обновлениям от этого подписанта."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "匹配由 %@ 签名且软件包为 %@ 的未来构建。仅当你信任该签名方的未来更新时使用。"
          }
        }
      }
    },
    "Matches future builds signed by %@. Use only if you trust future updates from that signer.": {
