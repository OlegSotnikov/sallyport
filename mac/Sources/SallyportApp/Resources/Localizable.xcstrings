    "Require approval for each tool invocation. Initialization and tool discovery do not show a per-call prompt.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Require approval for each tool invocation. Initialization and tool discovery do not show a per-call prompt."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Freigabe für jeden Tool-Aufruf verlangen. Initialisierung und Tool-Suche zeigen keine Freigabeanfrage pro Aufruf."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Requiere aprobación para cada invocación de herramienta. La inicialización y la detección de herramientas no muestran una solicitud por llamada."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Exiger une autorisation pour chaque appel d’outil. L’initialisation et la découverte d’outils n’affichent pas de demande par appel."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Exigir aprovação para cada invocação de ferramenta. A inicialização e a descoberta de ferramentas não exibem uma solicitação por chamada."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Требовать подтверждение для каждого вызова инструмента. При инициализации и обнаружении инструментов отдельный запрос не появляется."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "每次调用工具时都需要批准。初始化和工具发现不会显示逐次批准提示。"
          }
        }
      }
    },
    "Require approval for each use of this key, including approved agent sessions.": {
