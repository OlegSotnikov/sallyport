        },
        "zh-Hans": {
          "stringUnit": { "state": "translated", "value": "系统默认" }
        }
      }
    },
    "System Default follows Language & Region in System Settings.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "System Default follows Language & Region in System Settings."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bei „Systemstandard“ gilt die Einstellung unter „Sprache & Region“ in den Systemeinstellungen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "«Por omisión del sistema» usa el ajuste de Idioma y región de Ajustes del Sistema."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le réglage par défaut suit le choix défini dans Langue et région des Réglages Système."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O padrão do sistema segue a opção definida em Idioma e Região nos Ajustes do Sistema."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Системный язык задаётся в разделе «Язык и регион» Системных настроек."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "“系统默认”会跟随“系统设置”中“语言与地区”的设置。"
          }
        }
      }
    },
    "Restart Sallyport to apply the language change.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Restart Sallyport to apply the language change."
