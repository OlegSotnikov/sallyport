    "An incompatible vault was found. Creating a new vault archives the old files.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "An incompatible vault was found. Creating a new vault archives the old files."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein inkompatibler Tresor wurde gefunden. Beim Erstellen eines neuen Tresors werden die alten Dateien archiviert."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se ha encontrado una bóveda incompatible. Al crear una nueva se archivan los archivos anteriores."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un coffre incompatible a été trouvé. La création d’un coffre archivera les anciens fichiers."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Foi encontrado um cofre incompatível. Criar um novo cofre arquivará os arquivos antigos."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Обнаружено несовместимое хранилище. При создании нового хранилища старые файлы архивируются."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "发现不兼容的密钥库。创建新密钥库会归档旧文件。"
          }
        }
      }
    },
    "Any MCP client that spawns a stdio server can launch the shim directly. It speaks MCP on stdin/stdout and talks to this app over its private socket.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Any MCP client that spawns a stdio server can launch the shim directly. It speaks MCP on stdin/stdout and talks to this app over its private socket."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Jeder MCP-Client, der einen stdio-Server startet, kann den Shim direkt ausführen. Er spricht MCP über stdin/stdout und kommuniziert über den privaten Socket mit dieser App."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cualquier cliente MCP que inicie un servidor stdio puede ejecutar el shim directamente. Habla MCP por stdin/stdout y se comunica con esta app mediante su socket privado."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tout client MCP capable de lancer un serveur stdio peut lancer directement le shim. Il utilise MCP sur stdin/stdout et communique avec cette app par son socket privé."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Qualquer cliente MCP que inicie um servidor stdio pode executar o shim diretamente. Ele usa MCP em stdin/stdout e se comunica com este app pelo socket privado."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Любой клиент MCP, запускающий stdio-сервер, может напрямую запустить адаптер. Он обменивается сообщениями MCP через stdin/stdout и связывается с приложением через закрытый сокет."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "任何可生成 stdio 服务器进程的 MCP 客户端都能直接启动 shim。它通过 stdin/stdout 使用 MCP，并通过专用套接字与此 App 通信。"
          }
        }
      }
    },
    "Any host binding that references this key will stop working.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Any host binding that references this key will stop working."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Alle Hostbindungen, die auf diesen Schlüssel verweisen, funktionieren dann nicht mehr."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Todas las vinculaciones de host que hagan referencia a esta clave dejarán de funcionar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Toute liaison d’hôte qui référence cette clé cessera de fonctionner."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
