    "Development auto-approval is on. Approval decisions are not signed; audit rows use a separate signer.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Development auto-approval is on. Approval decisions are not signed; audit rows use a separate signer."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die automatische Entwicklungsfreigabe ist aktiviert. Freigabeentscheidungen werden nicht signiert; Auditzeilen verwenden einen separaten Signaturschlüssel."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La aprobación automática de desarrollo está activada. Las decisiones de aprobación no se firman; las filas de auditoría usan un firmante independiente."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’autorisation automatique de développement est activée. Les décisions d’autorisation ne sont pas signées ; les lignes d’audit utilisent un signataire distinct."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A aprovação automática de desenvolvimento está ativada. As decisões de aprovação não são assinadas; as linhas de auditoria usam um signatário separado."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Автоматические разрешения для разработки включены. Решения не подписываются; для записей аудита используется отдельный ключ подписи."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "开发自动批准已开启。批准决定未签名；审计记录由单独的签名方签名。"
          }
        }
      }
    },
    "Development software keys are in use. Release builds on Apple Silicon use Secure Enclave and Touch ID.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Development software keys are in use. Release builds on Apple Silicon use Secure Enclave and Touch ID."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Es werden Software-Entwicklungsschlüssel verwendet. Release-Builds auf Apple Silicon verwenden Secure Enclave und Touch ID."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se están usando claves de software de desarrollo. Las versiones de lanzamiento para Apple Silicon usan Secure Enclave y Touch ID."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Des clés logicielles de développement sont utilisées. Sur Apple Silicon, les versions publiées utilisent Secure Enclave et Touch ID."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Chaves de software de desenvolvimento estão em uso. No Apple Silicon, as versões de lançamento usam Secure Enclave e Touch ID."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Используются программные ключи для разработки. В релизных сборках для Apple Silicon применяются Secure Enclave и Touch ID."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "正在使用开发软件密钥。Apple Silicon 上的发布构建使用 Secure Enclave 和 Touch ID。"
          }
        }
      }
    },
    "Development software keys are in use. Vault and audit keys are not Secure Enclave backed.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Development software keys are in use. Vault and audit keys are not Secure Enclave backed."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Es werden Software-Entwicklungsschlüssel verwendet. Tresor- und Auditschlüssel sind nicht durch Secure Enclave geschützt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se están usando claves de software de desarrollo. Las claves de la bóveda y de auditoría no están protegidas por Secure Enclave."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Des clés logicielles de développement sont utilisées. Les clés du coffre et de l’audit ne sont pas protégées par Secure Enclave."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Chaves de software de desenvolvimento estão em uso. As chaves do cofre e da auditoria não são protegidas pelo Secure Enclave."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Используются программные ключи для разработки. Ключи хранилища и аудита не защищены Secure Enclave."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "正在使用开发软件密钥。密钥库和审计密钥不受 Secure Enclave 保护。"
          }
        }
      }
    },
