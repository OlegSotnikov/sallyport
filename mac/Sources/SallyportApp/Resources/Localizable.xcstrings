    "Off. Manual lock, sleep, or app exit still closes the vault.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Off. Manual lock, sleep, or app exit still closes the vault."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Aus. Manuelles Sperren, Ruhezustand oder Beenden der App schließen den Tresor weiterhin."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Desactivado. La bóveda se sigue cerrando al bloquearla manualmente, poner el Mac en reposo o salir de la app."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Désactivé. Le verrouillage manuel, la suspension d’activité ou la fermeture de l’app ferment toujours le coffre."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
