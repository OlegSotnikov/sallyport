    "Add an app or executable. Match its exact code hash or signing identity. A code signature identifies software; it does not prove intent.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Add an app or executable. Match its exact code hash or signing identity. A code signature identifies software; it does not prove intent."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Füge eine App oder ausführbare Datei hinzu. Prüfe den exakten Code-Hash oder die Signaturidentität. Eine Codesignatur identifiziert Software; sie belegt keine Absicht."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Añade una app o un ejecutable. Comprueba su hash de código exacto o su identidad de firma. Una firma de código identifica el software, pero no demuestra su intención."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajoutez une app ou un exécutable. Faites correspondre son hachage de code exact ou son identité de signature. Une signature de code identifie un logiciel, mais ne prouve pas son intention."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Adicione um app ou executável. Use o hash exato do código ou a identidade de assinatura. Uma assinatura de código identifica o software, mas não comprova sua intenção."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Добавьте приложение или исполняемый файл. Сопоставление выполняется по точному хешу кода или идентификатору подписи. Подпись идентифицирует программу, но не подтверждает её намерения."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "添加 App 或可执行文件。匹配其确切代码哈希或签名身份。代码签名可标识软件，但不能证明其意图。"
          }
        }
      }
    },
    "Add an ssh-ed25519 key on Keys & APIs first.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Add an ssh-ed25519 key on Keys & APIs first."
          }
