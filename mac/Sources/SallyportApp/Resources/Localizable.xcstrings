    "256-bit ChaCha20-Poly1305 · memory only while unlocked · encrypts stored secrets and metadata": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "256-bit ChaCha20-Poly1305 · memory only while unlocked · encrypts stored secrets and metadata"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "256-Bit ChaCha20-Poly1305 · nur im entsperrten Zustand im Arbeitsspeicher · verschlüsselt gespeicherte Geheimnisse und Metadaten"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "ChaCha20-Poly1305 de 256 bits · solo en memoria mientras está desbloqueada · cifra los secretos y metadatos almacenados"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "ChaCha20-Poly1305 256 bits · uniquement en mémoire lorsque le coffre est déverrouillé · chiffre les secrets et métadonnées stockés"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "ChaCha20-Poly1305 de 256 bits · somente na memória enquanto o cofre está desbloqueado · criptografa segredos e metadados armazenados"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "256-битное шифрование ChaCha20-Poly1305 · ключ находится в памяти только при разблокированном хранилище · защищает сохранённые секреты и метаданные"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "256 位 ChaCha20-Poly1305 · 仅在解锁时驻留内存 · 加密存储的机密信息和元数据"
          }
        }
      }
    },
