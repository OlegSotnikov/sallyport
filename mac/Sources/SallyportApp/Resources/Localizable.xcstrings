    "New processes start without session approval. Calls are still logged, and per-call settings still apply.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "New processes start without session approval. Calls are still logged, and per-call settings still apply."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Neue Prozesse starten ohne Sitzungsfreigabe. Aufrufe werden weiterhin protokolliert und Einstellungen pro Aufruf gelten weiterhin."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los procesos nuevos se inician sin aprobación de sesión. Las llamadas se siguen registrando y los ajustes por llamada siguen aplicándose."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les nouveaux processus démarrent sans autorisation de session. Les appels restent consignés et les réglages par appel restent actifs."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Novos processos iniciam sem aprovação de sessão. As chamadas ainda são registradas e os ajustes por chamada continuam em vigor."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Новые процессы запускаются без подтверждения сеанса. Вызовы по-прежнему записываются, а настройки отдельных вызовов продолжают действовать."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "新进程无需会话批准即可启动。调用仍会被记录，每次调用的设置仍然适用。"
          }
        }
      }
    },
