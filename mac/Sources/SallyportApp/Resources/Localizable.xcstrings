            "state": "translated",
            "value": "Redémarrez Sallyport pour appliquer le changement de langue."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Reinicie o Sallyport para aplicar a alteração de idioma."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Перезапустите Sallyport, чтобы применить новый язык."
