    "Allowlisted agents skip session approval. Per-call approval and vault locking still apply.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Allowlisted agents skip session approval. Per-call approval and vault locking still apply."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Agenten auf der Zulassungsliste überspringen die Sitzungsfreigabe. Freigaben pro Aufruf und die Tresorsperre gelten weiterhin."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los agentes de la lista de permitidos omiten la aprobación de sesión. La aprobación por llamada y el bloqueo de la bóveda siguen aplicándose."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les agents de la liste d’autorisation ne nécessitent pas d’autorisation de session. L’autorisation par appel et le verrouillage du coffre restent actifs."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Agentes na lista de permissões não precisam de aprovação de sessão. A aprovação por chamada e o bloqueio do cofre continuam em vigor."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Разрешённым агентам не требуется подтверждение сеанса. Подтверждение каждого вызова и блокировка хранилища продолжают действовать."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "允许列表中的智能体会跳过会话批准。每次调用的批准规则和密钥库锁定仍然适用。"
          }
        }
      }
    },
