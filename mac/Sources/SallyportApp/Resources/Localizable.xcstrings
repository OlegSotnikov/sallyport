    "Sallyport could not restart.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sallyport could not restart."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sallyport konnte nicht neu gestartet werden."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo reiniciar Sallyport."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossible de redémarrer Sallyport."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível reiniciar o Sallyport."
          }
        },
        "ru": {
