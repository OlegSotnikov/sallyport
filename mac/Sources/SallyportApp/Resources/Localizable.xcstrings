    "This executable has no valid code signature. Verify it before allowlisting.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This executable has no valid code signature. Verify it before allowlisting."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese ausführbare Datei hat keine gültige Codesignatur. Überprüfe sie, bevor du sie zur Zulassungsliste hinzufügst."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este ejecutable no tiene una firma de código válida. Verifícalo antes de añadirlo a la lista de permitidos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cet exécutable n’a pas de signature de code valide. Vérifiez-le avant de l’ajouter à la liste d’autorisation."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Este executável não tem uma assinatura de código válida. Verifique-o antes de adicioná-lo à lista de permissões."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "У этого исполняемого файла нет действительной подписи кода. Проверьте файл перед добавлением в список разрешённых."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此可执行文件没有有效代码签名。加入允许列表前，请先验证。"
          }
        }
      }
    },
