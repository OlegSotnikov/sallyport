    "“%@” is already pinned with an older build of this identity. Saving replaces that pin with this build and keeps its scope.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@” is already pinned with an older build of this identity. Saving replaces that pin with this build and keeps its scope."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "„%@“ ist bereits mit einem älteren Build dieser Identität fixiert. Beim Speichern wird die Fixierung durch diesen Build ersetzt; der Geltungsbereich bleibt erhalten."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "«%@» ya está fijado con una compilación anterior de esta identidad. Al guardar, se reemplaza esa fijación por esta compilación y se conserva su alcance."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "« %@ » est déjà épinglé avec une version antérieure de cette identité. L’enregistrement remplace cet épinglage par cette version et conserve sa portée."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@” já está fixado com uma compilação anterior desta identidade. Salvar substitui essa fixação por esta compilação e mantém o escopo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "«%@» уже закреплён за более старой сборкой этой идентичности. Сохранение заменит закрепление на эту сборку, область действия сохранится."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@”已固定为此身份的旧版本。保存后将以此版本替换固定，并保留其作用范围。"
          }
        }
      }
    }
  },
  "version": "1.1"
}
