    "Each new process requires Touch ID. Approval lasts until the process exits, you revoke it, or the vault locks.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Each new process requires Touch ID. Approval lasts until the process exits, you revoke it, or the vault locks."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Jeder neue Prozess erfordert Touch ID. Die Freigabe gilt, bis der Prozess beendet, die Freigabe widerrufen oder der Tresor gesperrt wird."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cada proceso nuevo requiere Touch ID. La aprobación dura hasta que el proceso termina, la revocas o se bloquea la bóveda."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Chaque nouveau processus requiert Touch ID. L’autorisation reste valable jusqu’à ce que le processus se termine, que vous la révoquiez ou que le coffre se verrouille."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Cada novo processo exige Touch ID. A aprovação permanece válida até que o processo seja encerrado, você a revogue ou o cofre seja bloqueado."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Для каждого нового процесса требуется Touch ID. Разрешение действует до завершения процесса, его отзыва или блокировки хранилища."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "每个新进程都需要 Touch ID。批准有效期至进程退出、你撤销批准或密钥库锁定。"
          }
        }
      }
    },
    "Each new process requires one click. Approval lasts until the process exits, you revoke it, or the vault locks.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Each new process requires one click. Approval lasts until the process exits, you revoke it, or the vault locks."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Jeder neue Prozess erfordert einen Klick. Die Freigabe gilt, bis der Prozess beendet, die Freigabe widerrufen oder der Tresor gesperrt wird."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cada proceso nuevo requiere un clic. La aprobación dura hasta que el proceso termina, la revocas o se bloquea la bóveda."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Chaque nouveau processus requiert un clic. L’autorisation reste valable jusqu’à ce que le processus se termine, que vous la révoquiez ou que le coffre se verrouille."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Cada novo processo exige um clique. A aprovação permanece válida até que o processo seja encerrado, você a revogue ou o cofre seja bloqueado."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Для каждого нового процесса нужен один щелчок. Разрешение действует до завершения процесса, его отзыва или блокировки хранилища."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "每个新进程都需要点按一次。批准有效期至进程退出、你撤销批准或密钥库锁定。"
          }
        }
      }
    },
