    "Stored credentials are unavailable while the vault is locked.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Stored credentials are unavailable while the vault is locked."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gespeicherte Zugangsdaten sind nicht verfügbar, solange der Tresor gesperrt ist."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las credenciales almacenadas no están disponibles mientras la bóveda está bloqueada."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les données d’authentification stockées sont indisponibles lorsque le coffre est verrouillé."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "As credenciais armazenadas ficam indisponíveis enquanto o cofre está bloqueado."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сохранённые учётные данные недоступны, пока хранилище заблокировано."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "密钥库锁定时，已存储的凭证不可用。"
          }
        }
      }
    },
    "Stored secret values are not shown in this interface.": {
      "localizations": {
        "en": {
