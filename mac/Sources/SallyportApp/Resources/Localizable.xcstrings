    "Run the command once, or add the same entry to your project's .mcp.json. Sallyport attaches credentials only when sending requests.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Run the command once, or add the same entry to your project's .mcp.json. Sallyport attaches credentials only when sending requests."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Führe den Befehl einmal aus oder füge denselben Eintrag zur .mcp.json deines Projekts hinzu. Sallyport fügt Zugangsdaten erst beim Senden von Anfragen an."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ejecuta el comando una vez o añade la misma entrada al archivo .mcp.json de tu proyecto. Sallyport solo adjunta credenciales al enviar solicitudes."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Exécutez la commande une fois ou ajoutez la même entrée au fichier .mcp.json de votre projet. Sallyport ne joint les données d’authentification qu’à l’envoi des requêtes."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Execute o comando uma vez ou adicione a mesma entrada ao .mcp.json do seu projeto. O Sallyport anexa as credenciais somente ao enviar solicitações."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Выполните команду один раз или добавьте такую же запись в файл .mcp.json проекта. Sallyport добавляет учётные данные только при отправке запросов."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "运行一次该命令，或将相同条目添加到项目的 .mcp.json。Sallyport 仅在发送请求时附加凭证。"
          }
        }
      }
    },
