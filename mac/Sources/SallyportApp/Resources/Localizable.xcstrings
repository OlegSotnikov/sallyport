    },
    "Uses vault credentials for configured actions without exposing the vault to the agent. Target responses are returned without content filtering.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Uses vault credentials for configured actions without exposing the vault to the agent. Target responses are returned without content filtering."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Verwendet Tresor-Zugangsdaten für konfigurierte Aktionen, ohne dem Agenten Zugriff auf den Tresor zu geben. Zielantworten werden ohne Inhaltsfilterung zurückgegeben."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Usa las credenciales de la bóveda para las acciones configuradas sin exponer la bóveda al agente. Las respuestas del destino se devuelven sin filtrar su contenido."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Utilise les identifiants du coffre pour les actions configurées sans exposer le coffre à l’agent. Les réponses des cibles sont renvoyées sans filtrage du contenu."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Usa credenciais do cofre em ações configuradas sem expor o cofre ao agente. As respostas do destino são retornadas sem filtragem de conteúdo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Использует учётные данные из хранилища для настроенных действий, не открывая агенту доступ к хранилищу. Ответы целей возвращаются без фильтрации."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "使用保险库凭证执行已配置的操作，而不向智能体开放保险库。目标响应未经内容过滤即返回。"
          }
        }
      }
    },
