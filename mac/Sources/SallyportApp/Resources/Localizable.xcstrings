    "Permanently erases stored keys and configuration. There is no backup or recovery. You must reissue keys from their providers.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Permanently erases stored keys and configuration. There is no backup or recovery. You must reissue keys from their providers."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Löscht gespeicherte Schlüssel und Konfiguration dauerhaft. Es gibt weder Sicherung noch Wiederherstellung. Du musst die Schlüssel von ihren Anbietern neu ausstellen lassen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Borra de forma permanente las claves y la configuración almacenadas. No hay copia de seguridad ni recuperación. Debes solicitar a sus proveedores que vuelvan a emitir las claves."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Efface définitivement les clés et la configuration stockées. Il n’existe ni sauvegarde ni récupération. Vous devrez faire réémettre les clés par leurs fournisseurs."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Apaga permanentemente as chaves e configurações armazenadas. Não há backup nem recuperação. Você precisará reemitir as chaves junto aos provedores."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Безвозвратно удаляет сохранённые ключи и конфигурацию. Резервной копии и восстановления нет. Получите новые ключи у их поставщиков."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "永久抹掉已存储的密钥和配置。没有备份或恢复方式。你必须从提供方重新签发密钥。"
          }
        }
      }
    },
