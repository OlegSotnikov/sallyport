    "Auto-lock is off. Manual lock, sleep, or app exit still closes the vault.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Auto-lock is off. Manual lock, sleep, or app exit still closes the vault."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die automatische Sperre ist aus. Manuelles Sperren, Ruhezustand oder Beenden der App schließen den Tresor weiterhin."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El bloqueo automático está desactivado. La bóveda se sigue cerrando al bloquearla manualmente, poner el Mac en reposo o salir de la app."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le verrouillage automatique est désactivé. Le verrouillage manuel, la suspension d’activité ou la fermeture de l’app ferment toujours le coffre."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O bloqueio automático está desativado. O bloqueio manual, o repouso ou o encerramento do app ainda fecham o cofre."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Автоблокировка выключена. Ручная блокировка, переход в режим сна и выход из приложения всё равно блокируют хранилище."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "自动锁定已关闭。手动锁定、睡眠或退出 App 仍会关闭密钥库。"
          }
        }
      }
    },
