    "The vault is quarantined. Review the integrity warning before continuing.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The vault is quarantined. Review the integrity warning before continuing."
          }
        },
        "de": {
