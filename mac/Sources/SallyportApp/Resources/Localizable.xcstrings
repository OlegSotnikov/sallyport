    "Use 1–40 letters, numbers, hyphens, or underscores for the server name.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Use 1–40 letters, numbers, hyphens, or underscores for the server name."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Servername darf 1–40 Zeichen lang sein und nur Buchstaben, Ziffern, Bindestriche oder Unterstriche enthalten."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El nombre del servidor debe tener entre 1 y 40 caracteres: letras, números, guiones o guiones bajos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Utilisez de 1 à 40 lettres, chiffres, traits d’union ou traits de soulignement pour le nom du serveur."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Use de 1 a 40 letras, números, hífens ou sublinhados no nome do servidor."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Имя сервера должно содержать от 1 до 40 букв, цифр, дефисов или знаков подчёркивания."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "服务器名称须为 1 至 40 个字符，只能包含字母、数字、连字符或下划线。"
          }
        }
      }
    },
    "Vault data changed. Sallyport blocked access. Accept the current state in the app to continue.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Vault data changed. Sallyport blocked access. Accept the current state in the app to continue."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Tresordaten haben sich geändert. Sallyport hat den Zugriff blockiert. Übernimm in der App den aktuellen Zustand, um fortzufahren."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los datos de la bóveda han cambiado. Sallyport ha bloqueado el acceso. Acepta el estado actual en la app para continuar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les données du coffre ont changé. Sallyport a bloqué l’accès. Acceptez l’état actuel dans l’app pour continuer."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Os dados do cofre mudaram. O Sallyport bloqueou o acesso. Para continuar, aceite o estado atual no app."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Данные хранилища изменились. Sallyport заблокировал доступ. Чтобы продолжить, примите текущее состояние в приложении."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "密钥库数据已更改。Sallyport 已阻止访问。请在 App 中接受当前状态以继续。"
          }
        }
      }
    },
    "Agents detected on this Mac. Their signing identity is verified at capture time.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Agents detected on this Mac. Their signing identity is verified at capture time."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Auf diesem Mac erkannte Agenten. Ihre Signaturidentität wird beim Erfassen überprüft."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Agentes detectados en este Mac. Su identidad de firma se verifica al capturar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Agents détectés sur ce Mac. Leur identité de signature est vérifiée au moment de la capture."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Agentes detectados neste Mac. A identidade de assinatura é verificada no momento da captura."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Агенты, обнаруженные на этом Mac. Их подпись проверяется в момент захвата."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在这台 Mac 上检测到的智能体。其签名身份会在捕获时验证。"
          }
        }
      }
    },
    "Every script this runtime executes shares this identity.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Every script this runtime executes shares this identity."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Jedes Skript, das diese Laufzeitumgebung ausführt, teilt diese Identität."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Todos los scripts que ejecuta este entorno comparten esta identidad."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Chaque script exécuté par cet environnement partage cette identité."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Todo script executado por este runtime compartilha esta identidade."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Каждый скрипт этой среды выполнения имеет ту же идентичность."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此运行时执行的每个脚本都共享这一身份。"
          }
        }
      }
    },
    "Every script this runtime executes shares this identity. It does not name one agent.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Every script this runtime executes shares this identity. It does not name one agent."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Jedes Skript, das diese Laufzeitumgebung ausführt, teilt diese Identität. Sie bezeichnet keinen bestimmten Agenten."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Todos los scripts que ejecuta este entorno comparten esta identidad. No identifica a un agente concreto."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Chaque script exécuté par cet environnement partage cette identité. Elle ne désigne pas un agent précis."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Todo script executado por este runtime compartilha esta identidade. Ela não identifica um agente específico."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Каждый скрипт этой среды выполнения имеет ту же идентичность. Она не указывает на конкретного агента."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此运行时执行的每个脚本都共享这一身份。它并不指向某一个智能体。"
          }
        }
      }
    },
