          }
        }
      }
    },
    "The requesting process is a shell, typically a command another program ran.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The requesting process is a shell, typically a command another program ran."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der anfragende Prozess ist eine Shell, üblicherweise ein Befehl, den ein anderes Programm ausgeführt hat."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El proceso solicitante es un shell, normalmente un comando ejecutado por otro programa."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le processus demandeur est un shell, généralement une commande exécutée par un autre programme."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O processo solicitante é um shell, normalmente um comando executado por outro programa."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Запрашивающий процесс — оболочка, обычно команда, запущенная другой программой."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "发出请求的进程是一个 shell，通常是另一个程序运行的命令。"
          }
        }
      }
    },
    "This executable is a script runtime. Its identity covers every script it runs, not one agent.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This executable is a script runtime. Its identity covers every script it runs, not one agent."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese ausführbare Datei ist eine Skript-Laufzeitumgebung. Ihre Identität umfasst jedes Skript, das sie ausführt, nicht einen bestimmten Agenten."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este ejecutable es un entorno de ejecución de scripts. Su identidad cubre todos los scripts que ejecuta, no un agente concreto."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cet exécutable est un environnement d’exécution de scripts. Son identité couvre chaque script qu’il exécute, pas un agent précis."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Este executável é um runtime de scripts. Sua identidade cobre todos os scripts que ele executa, não um agente específico."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Этот исполняемый файл — среда выполнения скриптов. Её идентичность покрывает все запускаемые ею скрипты, а не одного агента."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此可执行文件是脚本运行时。其身份涵盖它运行的所有脚本，而非某一个智能体。"
          }
        }
      }
    },
