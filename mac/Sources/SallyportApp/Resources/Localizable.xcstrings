      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose the app or executable to allowlist. For scripts, add the running process from Sessions."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wähle die App oder ausführbare Datei für die Zulassungsliste. Füge Skripte über den zugehörigen Prozess unter „Sitzungen“ hinzu."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Elige la app o el ejecutable que quieres permitir. Para scripts, añade el proceso en ejecución desde Sesiones."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Choisissez l’app ou l’exécutable à ajouter à la liste d’autorisation. Pour les scripts, ajoutez le processus en cours depuis Sessions."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Escolha o app ou executável para adicionar à lista de permissões. Para scripts, adicione o processo em execução em Sessões."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Выберите приложение или исполняемый файл, который нужно разрешить. Для скрипта добавьте запущенный процесс на вкладке «Сеансы»."
