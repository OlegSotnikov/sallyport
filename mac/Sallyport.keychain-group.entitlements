<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>keychain-access-groups</key>
	<array>
		<string>9MZ2ZL5CA3.dev.sallyport.mac</string>
	</array>
	<!-- Required under the hardened runtime for the opt-in terminal reveal
	     feature. macOS still prompts the user for Automation permission. -->
	<key>com.apple.security.automation.apple-events</key>
	<true/>
</dict>
</plist>
