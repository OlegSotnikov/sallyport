{
  "sourceLanguage" : "en",
  "strings" : {
    "NSAppleEventsUsageDescription" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sallyport bringt das Terminalfenster der ausgewählten Agentensitzung in den Vordergrund."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sallyport brings the terminal window for the selected agent session to the front."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sallyport trae al frente la ventana de terminal de la sesión de agente seleccionada."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sallyport place au premier plan la fenêtre de terminal de la session d’agent sélectionnée."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Sallyport traz para a frente a janela do Terminal da sessão de agente selecionada."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sallyport выводит на передний план окно терминала выбранного сеанса агента."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sallyport 会将所选代理会话的终端窗口置于前台。"
          }
        }
      }
    },
    "NSFaceIDUsageDescription" : {
